# JWT for POST /auth/register and /auth/login (python-jose)
SECRET_KEY=change-me-in-production

# LLM: rag stack uses local Ollama (see rag/Modelfile); model name must match Ollama, e.g. PhanarAi
# Yandex block below is unused while services/llm.py is on the Ollama path from integrate branch.

LLM_PROVIDER=yandex
LLM_API_KEY=

YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite/latest
YANDEX_TEMPERATURE=0.2
YANDEX_MAX_TOKENS=300
YANDEX_TIMEOUT_SECONDS=12

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
DATABASE_URL=
PORT=8000