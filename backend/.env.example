# JWT for POST /auth/register and /auth/login (python-jose)
SECRET_KEY=change-me-in-production

# LLM: services/llm.py uses LangChain -> Ollama HTTP API only (Yandex vars below are unused).
# Start the Ollama app / daemon so something listens on the URL below (default API port 11434).
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Must match `ollama list` NAME exactly (e.g. llama3, llama3:8b, PhanarAi — tags differ).
OLLAMA_MODEL=PhanarAi

LLM_PROVIDER=yandex
LLM_API_KEY=

YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite/latest
YANDEX_TEMPERATURE=0.2
YANDEX_MAX_TOKENS=300
YANDEX_TIMEOUT_SECONDS=12

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
DATABASE_URL=
PORT=8000