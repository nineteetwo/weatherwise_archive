# JWT for POST /auth/register and /auth/login (python-jose)
SECRET_KEY=change-me-in-production

# LLM: services/llm.py → LangChain ChatOllama (local Ollama HTTP API only).
# Start Ollama so something listens at the URL below (default API port 11434).
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Must match `ollama list` NAME exactly (e.g. llama3 vs llama3:8b — tags differ).
OLLAMA_MODEL=llama3

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
DATABASE_URL=
PORT=8000